{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./app/*"]
    },
    "types": ["node", "next", "next/image-types/global"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    "middleware.js",
    "app/api/exhibitions/delete-image/route.js",
    "scripts/sitemap.js",
    "app/[locale]/page.js",
    "next-intl.config.mjs",
    "app/components/ImageDisplay.jsx",
    "app/components/Search.jsx"
  ],
  "exclude": ["node_modules"]
}
